# Postgres (Neon). Без него локально используется встроенная база PGlite в папке .pglite
DATABASE_URL=

# Код для входа в приложение и для привязки Telegram-бота. Обязателен в продакшене.
ACCESS_CODE=

# Любая длинная случайная строка — ею подписывается кука сессии.
SESSION_SECRET=

# Токен бота из @BotFather. Без него уведомления просто не отправляются.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — показывается кнопкой «Открыть бота» в настройках.
TELEGRAM_BOT_USERNAME=
# Необязательно: секрет, которым Telegram подписывает вебхуки.
TELEGRAM_WEBHOOK_SECRET=

# Секрет для планировщика уведомлений.
CRON_SECRET=

# Адрес приложения. На Vercel определяется автоматически, задавать не нужно.
APP_URL=
